      "displayName": "Killer Bee Queen",
      "primaryArchetype": "killer-bee-queen",
      "spawns": {
        "comment": "K10: a single boss, not a swarm. One enemy at t=0 and never again - everySeconds null means the periodic schedule never repeats.",
