{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=12.2.1 <13"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "audit": "npm audit --omit=dev --audit-level=high",
    "preview": "vite preview",
    "test": "vitest run --project node --project dom --coverage",
    "test:coverage": "vitest run --project node --coverage",
    "test:watch": "vitest",
    "test:soak:sim": "vitest run --project soak",
    "bench": "vitest bench --run --project \"node (bench)\"",
    "typecheck": "tsc -b",
    "verify": "node scripts/verify.mjs",
    "test:mutation": "stryker run",
    "test:mutation:diff": "node scripts/mutation-diff.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@flatten-js/core": "^1.6.14",
    "@fontsource-variable/grenze-gotisch": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
