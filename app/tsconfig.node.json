{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,

    /* Bundler mode: the specs import app types (lint rule
       test-drift/typed-exact-expectation), and app source uses
       extensionless imports, which nodenext rejects. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.mutation.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "lint/**/*.ts"
  ]
}
